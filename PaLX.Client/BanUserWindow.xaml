<Window x:Class="PaLX.Client.BanUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bannir un utilisateur" Height="460" Width="500"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">
    
    <Border CornerRadius="20" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#FAFAFA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- HEADER - Red gradient -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="24,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#EF4444" Offset="0"/>
                        <GradientStop Color="#DC2626" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Ban Icon (SVG Path) -->
                        <Viewbox Width="28" Height="28" Margin="0,0,12,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z" 
                                      Fill="White"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Bannir un utilisateur" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseButton_Click" Cursor="Hand"
                            Width="32" Height="32" ToolTip="Fermer">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="8" Background="Transparent">
                                    <TextBlock Text="✕" Foreground="White" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- CONTENT -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20">
                    <!-- User Info -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Width="48" Height="48" Margin="0,0,14,0">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="UserAvatar" ImageSource="/Assets/default_avatar.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UsernameText" Text="Username" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="sera banni du salon" FontSize="13" Foreground="#DC2626"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- DURATION SELECTION -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <TextBlock Text="Durée du bannissement" FontSize="13" FontWeight="Medium" Foreground="#6B7280" Margin="0,0,0,10"/>
                    
                    <Border CornerRadius="12" Background="#F9FAFB" Padding="8" Margin="0,0,0,16">
                        <UniformGrid Rows="2" Columns="2">
                            <!-- 1 Hour -->
                            <RadioButton x:Name="Duration1h" GroupName="Duration" Margin="4" Cursor="Hand" Click="Duration_Click">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="border" CornerRadius="10" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="1 heure" FontSize="13" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEF2F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- 24 Hours -->
                            <RadioButton x:Name="Duration24h" GroupName="Duration" Margin="4" Cursor="Hand" Click="Duration_Click">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="border" CornerRadius="10" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="24 heures" FontSize="13" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEF2F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- 7 Days -->
                            <RadioButton x:Name="Duration7d" GroupName="Duration" Margin="4" Cursor="Hand" Click="Duration_Click">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="border" CornerRadius="10" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="7 jours" FontSize="13" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEF2F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Permanent -->
                            <RadioButton x:Name="DurationPermanent" GroupName="Duration" Margin="4" Cursor="Hand" IsChecked="True" Click="Duration_Click">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="border" CornerRadius="10" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🚫 Permanent" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#DC2626"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FEF2F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- REASON INPUT -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <TextBlock Text="Raison du bannissement (optionnel)" FontSize="13" FontWeight="Medium" Foreground="#6B7280" Margin="0,0,0,8"/>
                    
                    <Border CornerRadius="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="4">
                        <TextBox x:Name="ReasonTextBox" Height="70" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="14" Foreground="#374151"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="500"
                                 Padding="12,10">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                    
                    <!-- Warning message for permanent -->
                    <Border x:Name="PermanentWarning" CornerRadius="10" Background="#FEF3C7" Padding="12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Un ban permanent ne peut être annulé que par un administrateur." 
                                       FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- BUTTONS -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="28,0,28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel Button -->
                    <Button Grid.Column="0" Content="Annuler" Height="46" Click="CancelButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="12" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#6B7280" FontWeight="SemiBold" FontSize="14" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#D1D5DB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Ban Button -->
                    <Button Grid.Column="2" x:Name="BanButton" Content="🚫 Bannir" Height="46" Click="BanButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#EF4444" Offset="0"/>
                                            <GradientStop Color="#DC2626" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#EF4444" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                                    </Border.Effect>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontWeight="SemiBold" FontSize="14" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#DC2626" Offset="0"/>
                                                    <GradientStop Color="#B91C1C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#B91C1C" Offset="0"/>
                                                    <GradientStop Color="#991B1B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
