<Window x:Class="PaLX.Client.InviteToRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PaLX.Client.Converters"
        Title="Inviter des amis"
        Height="520" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryGreen" Color="#66BB6A"/>
        <SolidColorBrush x:Key="PrimaryGreenHover" Color="#81C784"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="White"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        
        <!-- URL to Image Converter -->
        <converters:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter"/>
        
        <!-- Bool to Opacity Converter (for graying out friends already in room) -->
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        
        <!-- InRoom to Color Converter (green for "already in room" text) -->
        <converters:InRoomToColorConverter x:Key="InRoomToColorConverter"/>
        
        <!-- Checkbox Style -->
        <Style x:Key="FriendCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Border" Width="22" Height="22" 
                                    Background="#3D3D3D" CornerRadius="5" 
                                    BorderThickness="2" BorderBrush="#555"/>
                            <Path x:Name="CheckMark" 
                                  Data="M9.86,18 L3.5,11.64 L5.36,9.79 L9.86,14.29 L18.64,5.5 L20.5,7.36 Z"
                                  Fill="White" Stretch="Uniform"
                                  Width="14" Height="14"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#66BB6A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#66BB6A"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#81C784"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Friend ListBox Item Style -->
        <Style x:Key="FriendItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" 
                                Background="Transparent" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2066BB6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDark}" 
            CornerRadius="16" 
            BorderThickness="1" 
            BorderBrush="{StaticResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="#2D2D2D" CornerRadius="16,16,0,0" Padding="20,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon -->
                    <Border Grid.Column="0" Background="#66BB6A" CornerRadius="10" Width="40" Height="40" Margin="0,0,14,0">
                        <Path Fill="White" Stretch="Uniform" Width="20" Height="20"
                              Data="M15,14 C12.33,14 7,15.33 7,18 L7,20 L23,20 L23,18 C23,15.33 17.67,14 15,14 Z M6,10 L6,7 L4,7 L4,10 L1,10 L1,12 L4,12 L4,15 L6,15 L6,12 L9,12 L9,10 L6,10 Z M15,12 C17.21,12 19,10.21 19,8 C19,5.79 17.21,4 15,4 C12.79,4 11,5.79 11,8 C11,10.21 12.79,12 15,12 Z"/>
                    </Border>
                    
                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Inviter des amis" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="RoomNameText" Text="Dans le salon..." FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2" Click="Close_Click" 
                            Background="Transparent" Width="32" Height="32" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="✕" Foreground="#888" FontSize="16" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#40FF5555"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Room Info Preview -->
            <Border Grid.Row="1" Background="#252525" Padding="16,12" Margin="16,12,16,0" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Room Icon -->
                    <Border Grid.Column="0" Background="#66BB6A" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                        <TextBlock x:Name="RoomIconText" Text="💬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Room Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="RoomTitleText" Text="Nom du salon" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock x:Name="RoomCategoryText" Text="Catégorie" FontSize="11" Foreground="#AAAAAA"/>
                            </Border>
                            <TextBlock x:Name="RoomParticipantsText" Text="• 0 participants" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Friends List -->
            <Border Grid.Row="2" Margin="16,12,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Section Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Amis en ligne" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock x:Name="SelectedCountText" Text="0 sélectionné(s)" 
                                   FontSize="12" Foreground="#66BB6A" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <!-- Friends ListBox -->
                    <ListBox x:Name="FriendsListBox" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource FriendItemStyle}"
                             SelectionMode="Multiple"
                             SelectionChanged="FriendsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox (disabled if already in room) -->
                                    <CheckBox x:Name="FriendCheckBox" Grid.Column="0" 
                                              Style="{StaticResource FriendCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanBeInvited}"
                                              Opacity="{Binding CanBeInvited, Converter={StaticResource BoolToOpacityConverter}}"
                                              Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    
                                    <!-- Avatar (grayed out if in room) -->
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" 
                                            Background="#3D3D3D" Margin="0,0,12,0"
                                            Opacity="{Binding CanBeInvited, Converter={StaticResource BoolToOpacityConverter}}">
                                        <Grid>
                                            <Image Source="{Binding AvatarPath, Converter={StaticResource UrlToImageSourceConverter}}" 
                                                   Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                                </Image.Clip>
                                            </Image>
                                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AvatarPath}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Online indicator -->
                                            <Ellipse Width="12" Height="12" 
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusColor}" 
                                                     Stroke="#1E1E1E" StrokeThickness="2"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Name & Status -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                Opacity="{Binding CanBeInvited, Converter={StaticResource BoolToOpacityConverter}}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" 
                                                   Foreground="{Binding IsInRoom, Converter={StaticResource InRoomToColorConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" 
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="😔" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Aucun ami en ligne" FontSize="14" Foreground="#888" HorizontalAlignment="Center"/>
                        <TextBlock Text="Invitez vos amis à rejoindre PaLX!" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Footer with Actions -->
            <Border Grid.Row="3" Background="#252525" CornerRadius="0,0,16,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Select All -->
                    <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" 
                              Content="Tout sélectionner" 
                              Foreground="#AAAAAA" FontSize="12"
                              VerticalAlignment="Center"
                              Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
                    
                    <!-- Cancel -->
                    <Button Grid.Column="1" Content="Annuler" 
                            Background="#3D3D3D" Foreground="White"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Cancel_Click" Margin="0,0,10,0"/>
                    
                    <!-- Send Invitations -->
                    <Button x:Name="SendButton" Grid.Column="2" Content="Envoyer" 
                            Background="#66BB6A" Foreground="White"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Send_Click" IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
