<Window x:Class="PaLX.Client.WhisperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuchotement" 
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Border Background="#FF2D2D30" CornerRadius="12" BorderBrush="#FF007ACC" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#007ACC"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="#FF1E1E1E" CornerRadius="12,12,0,0" MouseDown="Header_MouseDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Whisper Icon -->
                        <Grid Width="24" Height="24" Margin="0,0,10,0">
                            <Ellipse Fill="#FF9C27B0" Width="24" Height="24"/>
                            <Path Fill="White" Data="M12,3 C17.5,3 22,6.5 22,11 C22,15.5 17.5,19 12,19 C10.8,19 9.6,18.8 8.5,18.5 L3,21 L4.5,16.5 C3.5,15 3,13.5 3,11 C3,6.5 6.5,3 12,3 Z" 
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,0,1"/>
                        </Grid>
                        <TextBlock Text="Chuchotement à " FontSize="15" Foreground="#B0FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecipientNameText" Text="User" FontSize="15" Foreground="#FF9C27B0" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Cursor="Hand"
                            Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#30FF5252"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="✕" Foreground="#80FFFFFF" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Message Area -->
            <Border Grid.Row="1" Margin="16,12" Background="#FF252525" CornerRadius="8" BorderBrush="#FF9C27B0" BorderThickness="1">
                <TextBox x:Name="WhisperTextBox" 
                         Background="#FF252525" 
                         Foreground="#FFFFFFFF" 
                         FontSize="14"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Padding="12"
                         MaxLength="500"
                         KeyDown="WhisperTextBox_KeyDown">
                    <TextBox.CaretBrush>
                        <SolidColorBrush Color="#FF9C27B0"/>
                    </TextBox.CaretBrush>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="SelectionBrush" Value="#FF9C27B0"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>
            
            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Character counter -->
                <TextBlock Grid.Column="0" x:Name="CharCountText" Text="0/500" 
                           Foreground="#60FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                
                <!-- Cancel Button -->
                <Button Grid.Column="1" Click="Cancel_Click" Margin="0,0,10,0" Cursor="Hand"
                        Width="100" Height="36" Background="#40FFFFFF" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#B0FFFFFF" Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" 
                                          Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Annuler" Foreground="#B0FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#50FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <!-- Send Button -->
                <Button Grid.Column="2" Click="Send_Click" Cursor="Hand"
                        Width="110" Height="36" Background="#FF9C27B0" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="White" Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z" 
                                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Envoyer" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FFB347"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
