<Window x:Class="PaLX.Client.KickUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kicker un utilisateur" Height="340" Width="480"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">
    
    <Border CornerRadius="20" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#FAFAFA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- HEADER - Orange/Amber gradient -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="24,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Kick Icon (SVG Path) -->
                        <Viewbox Width="28" Height="28" Margin="0,0,12,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8 0-1.85.63-3.55 1.69-4.9L16.9 18.31C15.55 19.37 13.85 20 12 20zm6.31-3.1L7.1 5.69C8.45 4.63 10.15 4 12 4c4.42 0 8 3.58 8 8 0 1.85-.63 3.55-1.69 4.9z" 
                                      Fill="White"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Kicker un utilisateur" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseButton_Click" Cursor="Hand"
                            Width="32" Height="32" ToolTip="Fermer">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="8" Background="Transparent">
                                    <TextBlock Text="✕" Foreground="White" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- CONTENT -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="28,24">
                <!-- User Info -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse Width="48" Height="48" Margin="0,0,14,0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="UserAvatar" ImageSource="/Assets/default_avatar.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UsernameText" Text="Username" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock Text="sera éjecté du salon" FontSize="13" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Reason Label -->
                <TextBlock Text="Raison du kick (optionnel)" FontSize="13" FontWeight="Medium" Foreground="#6B7280" Margin="0,0,0,8"/>
                
                <!-- Reason Input -->
                <Border CornerRadius="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="4">
                    <TextBox x:Name="ReasonTextBox" Height="70" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             FontSize="14" Foreground="#374151"
                             BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="500"
                             Padding="12,10">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                
                <TextBlock Text="L'utilisateur pourra revenir immédiatement dans le salon." 
                           FontSize="12" Foreground="#9CA3AF" FontStyle="Italic" Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- BUTTONS -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="28,0,28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel Button -->
                    <Button Grid.Column="0" Content="Annuler" Height="46" Click="CancelButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="12" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#6B7280" FontWeight="SemiBold" FontSize="14" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#D1D5DB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Kick Button -->
                    <Button Grid.Column="2" Content="⚡ Kicker" Height="46" Click="KickButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                            <GradientStop Color="#D97706" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                                    </Border.Effect>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontWeight="SemiBold" FontSize="14" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#D97706" Offset="0"/>
                                                    <GradientStop Color="#B45309" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#B45309" Offset="0"/>
                                                    <GradientStop Color="#92400E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
