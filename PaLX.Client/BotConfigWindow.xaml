<Window x:Class="PaLX.Client.BotConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration du Bot IA" 
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <!-- Style pour les CheckBox modernes -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- Style pour les TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252542"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3d3d6b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <!-- Style pour les boutons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#818CF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="12" Background="#1a1a2e" BorderBrush="#6366F1" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#6366F1" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <!-- Robot Icon -->
                        <Path Data="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z"
                              Fill="White" Width="28" Height="28" Stretch="Uniform"/>
                        <TextBlock Text="Configuration du Bot IA" 
                                   Foreground="White" FontSize="18" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,15,0" Width="30" Height="30"
                            Background="Transparent" Foreground="White" FontSize="16"
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content with Tabs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="15">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#252542"/>
                        <Setter Property="Foreground" Value="#888"/>
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                            CornerRadius="6,6,0,0" Margin="2,0">
                                        <ContentPresenter ContentSource="Header" Margin="10,5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#6366F1"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                
                <!-- Tab 1: Général -->
                <TabItem Header="⚙️ Général">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Bot Enable/Disable -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Activer le Bot" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Active ou désactive le bot pour ce salon" Foreground="#888" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="BotEnabledToggle" HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center" Width="50" Height="26"
                                                  Checked="BotEnabledToggle_Changed" Unchecked="BotEnabledToggle_Changed">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ToggleBorder" Background="#3d3d6b" CornerRadius="13" Cursor="Hand">
                                                    <Ellipse x:Name="ToggleCircle" Width="22" Height="22" Fill="White" 
                                                             HorizontalAlignment="Left" Margin="2,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ToggleBorder" Property="Background" Value="#10B981"/>
                                                        <Setter TargetName="ToggleCircle" Property="HorizontalAlignment" Value="Right"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            
                            <!-- Bot Name -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Nom du Bot" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBox x:Name="BotNameTextBox" Style="{StaticResource ModernTextBox}" 
                                             Margin="0,8,0,0" MaxLength="30"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Features -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Fonctionnalités" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <CheckBox x:Name="WelcomeMessageCheckBox" Style="{StaticResource ModernCheckBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👋" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Message de bienvenue" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    
                                    <CheckBox x:Name="ModerationCheckBox" Style="{StaticResource ModernCheckBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Modération automatique" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    
                                    <CheckBox x:Name="MentionResponseCheckBox" Style="{StaticResource ModernCheckBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💬" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Réponse aux mentions" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    
                                    <CheckBox x:Name="QuizCheckBox" Style="{StaticResource ModernCheckBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎯" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Quiz interactif" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    
                                    <CheckBox x:Name="TopicSuggestionCheckBox" Style="{StaticResource ModernCheckBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💡" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Sujets de discussion" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Tab 2: Modération -->
                <TabItem Header="🛡️ Modération">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Warning Settings -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Paramètres d'avertissement" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Avertissements avant kick" Foreground="#ccc" Grid.Row="0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="WarningsBeforeKickTextBox" Style="{StaticResource ModernTextBox}" 
                                                 Grid.Row="0" Grid.Column="1" TextAlignment="Center"/>
                                        
                                        <TextBlock Text="Reset après (minutes)" Foreground="#ccc" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBox x:Name="WarningResetMinutesTextBox" Style="{StaticResource ModernTextBox}" 
                                                 Grid.Row="1" Grid.Column="1" TextAlignment="Center" Margin="0,10,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Banned Words -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Mots interdits" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <!-- Add word form -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBox x:Name="NewWordTextBox" Style="{StaticResource ModernTextBox}" 
                                                 Grid.Column="0"/>
                                        
                                        <ComboBox x:Name="SeverityComboBox" Grid.Column="1" Margin="10,0"
                                                  Background="#252542" Foreground="White" SelectedIndex="0">
                                            <ComboBox.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2d2d4a"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#9B59B6"/>
                                            </ComboBox.Resources>
                                            <ComboBoxItem Content="Warning" Foreground="#333333"/>
                                            <ComboBoxItem Content="Kick" Foreground="#333333"/>
                                            <ComboBoxItem Content="Ban" Foreground="#333333"/>
                                        </ComboBox>
                                        
                                        <Button Content="+ Ajouter" Grid.Column="2" Style="{StaticResource ModernButton}"
                                                Click="AddBannedWord_Click" Padding="15,8"/>
                                    </Grid>
                                    
                                    <!-- Words list -->
                                    <Border Background="#1a1a2e" CornerRadius="6" MaxHeight="200">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="BannedWordsContainer">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#2d2d4a" CornerRadius="4" Margin="2" Padding="10,5">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Word}" Foreground="White" FontWeight="SemiBold"/>
                                                                    <Border Background="{Binding SeverityColor}" CornerRadius="3" Padding="5,2" Margin="10,0">
                                                                        <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="10"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <Button Content="🗑️" HorizontalAlignment="Right" 
                                                                        Background="Transparent" Foreground="#EF4444"
                                                                        BorderThickness="0" Cursor="Hand"
                                                                        Tag="{Binding Id}" Click="RemoveBannedWord_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Tab 3: Messages -->
                <TabItem Header="📝 Messages">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Welcome Message Template -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Message de bienvenue" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Utilisez {username} pour insérer le nom de l'utilisateur" 
                                               Foreground="#888" FontSize="11" Margin="0,3,0,8"/>
                                    <TextBox x:Name="WelcomeMessageTextBox" Style="{StaticResource ModernTextBox}" 
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Warning Message Template -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Message d'avertissement" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Variables: {username}, {reason}, {count}, {max}" 
                                               Foreground="#888" FontSize="11" Margin="0,3,0,8"/>
                                    <TextBox x:Name="WarningMessageTextBox" Style="{StaticResource ModernTextBox}" 
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Kick Message Template -->
                            <Border Background="#252542" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Message de kick" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Utilisez {username} pour insérer le nom de l'utilisateur" 
                                               Foreground="#888" FontSize="11" Margin="0,3,0,8"/>
                                    <TextBox x:Name="KickMessageTextBox" Style="{StaticResource ModernTextBox}" 
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            
            <!-- Footer -->
            <Border Grid.Row="2" Background="#252542">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                    <Button Content="Annuler" Style="{StaticResource ModernButton}" 
                            Background="#3d3d6b" Click="CancelButton_Click" Margin="0,0,10,0"/>
                    <Button Content="💾 Enregistrer" Style="{StaticResource ModernButton}" 
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
