<Window x:Class="PaLX.Client.EditBanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier le bannissement" Height="420" Width="400"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="False">
    
    <Border CornerRadius="16" Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#FAFAFA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✏️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Modifier le bannissement" FontSize="15" FontWeight="SemiBold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseButton_Click" Cursor="Hand"
                            Width="28" Height="28">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="6" Background="Transparent">
                                    <TextBlock Text="✕" Foreground="White" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="18,14,18,10">
                <!-- User Info Card -->
                <Border Background="#FEF3C7" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="40" Height="40">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="UserAvatar" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserDisplayName" Text="Utilisateur" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#92400E"/>
                            <TextBlock x:Name="UserUsername" Text="@username" FontSize="11" 
                                       Foreground="#B45309" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Current Ban Info -->
                <TextBlock Text="Statut actuel" FontSize="11" Foreground="#6B7280" FontWeight="Medium" Margin="0,0,0,6"/>
                <Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="CurrentTypeBadge" CornerRadius="5" Padding="8,3" Background="#F59E0B">
                            <TextBlock x:Name="CurrentTypeText" Text="TEMPORAIRE" FontSize="9" 
                                       FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="CurrentDurationText" Text="Expire dans: 2h 30min" 
                                   FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- New Duration Section -->
                <TextBlock Text="Nouvelle durée" FontSize="11" Foreground="#6B7280" FontWeight="Medium" Margin="0,0,0,8"/>
                
                <!-- Duration Type Selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="TemporaryRadio" Content="Temporaire" IsChecked="True" 
                                 Checked="DurationType_Changed" Margin="0,0,12,0" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" CornerRadius="8" Padding="14,8" Background="#F3F4F6" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="dot" Width="14" Height="14" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                        <TextBlock Text="{TemplateBinding Content}" Margin="6,0,0,0" 
                                                   FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FEF3C7"/>
                                        <Setter TargetName="dot" Property="Fill" Value="#F59E0B"/>
                                        <Setter TargetName="dot" Property="Stroke" Value="#F59E0B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    
                    <RadioButton x:Name="PermanentRadio" Content="Permanent" Checked="DurationType_Changed" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" CornerRadius="8" Padding="14,8" Background="#F3F4F6" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="dot" Width="14" Height="14" Stroke="#9CA3AF" StrokeThickness="2" Fill="Transparent"/>
                                        <TextBlock Text="{TemplateBinding Content}" Margin="6,0,0,0" 
                                                   FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                        <Setter TargetName="dot" Property="Fill" Value="#DC2626"/>
                                        <Setter TargetName="dot" Property="Stroke" Value="#DC2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <!-- Duration Selector (for Temporary) -->
                <Border x:Name="DurationPanel" Background="#F9FAFB" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Sélectionner la durée" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                        <ComboBox x:Name="DurationComboBox" SelectedIndex="2" Cursor="Hand" Height="32">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                            <ComboBoxItem Content="1 heure" Tag="60"/>
                            <ComboBoxItem Content="2 heures" Tag="120"/>
                            <ComboBoxItem Content="6 heures" Tag="360"/>
                            <ComboBoxItem Content="12 heures" Tag="720"/>
                            <ComboBoxItem Content="24 heures" Tag="1440"/>
                            <ComboBoxItem Content="3 jours" Tag="4320"/>
                            <ComboBoxItem Content="7 jours" Tag="10080"/>
                            <ComboBoxItem Content="30 jours" Tag="43200"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Warning for Permanent -->
                <Border x:Name="PermanentWarning" Background="#FEE2E2" CornerRadius="8" Padding="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Le bannissement permanent ne peut être levé que manuellement." 
                                   FontSize="10" Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Padding="18,0" Background="#F9FAFB" CornerRadius="0,0,16,16">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Annuler" Click="CancelButton_Click" Cursor="Hand" HorizontalAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="8" Padding="18,10" Background="#E5E7EB">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="Medium" 
                                               Foreground="#4B5563" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#D1D5DB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Grid.Column="1" Content="✓  Enregistrer" Click="ConfirmButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="8" Padding="20,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                            <GradientStop Color="#D97706" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#D97706" Offset="0"/>
                                                    <GradientStop Color="#B45309" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
