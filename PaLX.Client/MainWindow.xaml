<Window x:Class="PaLX.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaLX.Client"
        mc:Ignorable="d"
        Title="PaL.Xtreme" Height="720" Width="480"
        Icon="Assets/mounir.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">
    
    <Window.Resources>
        <!-- Window Chrome Buttons -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Main Container with Shadow -->
    <Border CornerRadius="24" Background="{StaticResource CardBackgroundBrush}" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Gradient and Window Controls -->
            <Border Grid.Row="0" CornerRadius="24,24,0,0" MinHeight="200" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E03E2F" Offset="0"/>
                        <GradientStop Color="#C93528" Offset="0.6"/>
                        <GradientStop Color="#B03020" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid>
                    <!-- Subtle Decorative Background -->
                    <Canvas ClipToBounds="True" Opacity="0.6">
                        <Ellipse Width="180" Height="180" Fill="#08FFFFFF" Canvas.Left="-50" Canvas.Top="-70"/>
                        <Ellipse Width="120" Height="120" Fill="#05FFFFFF" Canvas.Right="-20" Canvas.Top="100"/>
                        <Ellipse Width="60" Height="60" Fill="#0AFFFFFF" Canvas.Left="340" Canvas.Top="30"/>
                    </Canvas>
                    
                    <!-- Window Control Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
                        <Button Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click" ToolTip="Réduire">
                            <TextBlock Text="─" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Fermer">
                            <TextBlock Text="✕" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- Logo and Title -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,25,0,30">
                        <!-- App Icon - Clean Circle -->
                        <Border Width="76" Height="76" CornerRadius="38" Background="#20FFFFFF" Margin="0,0,0,18">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="0" Opacity="0.15"/>
                            </Border.Effect>
                            <!-- Flame Icon -->
                            <Viewbox Width="40" Height="40">
                                <Path Fill="White" Data="M12,23C10.41,23 8.88,22.67 7.5,22.08C8.11,22.37 8.77,22.5 9.5,22.5C12.54,22.5 15,20.04 15,17C15,14.91 13.77,13.09 12,12.24V11.5C12,8.46 9.54,6 6.5,6C6.29,6 6.08,6.03 5.87,6.05C7.27,4.73 9.07,4 11,4C15.41,4 19,7.59 19,12C19,18.63 12,23 12,23M12,2C6.5,2 2,6.5 2,12C2,17.5 6.5,22 12,22C17.5,22 22,17.5 22,12C22,6.5 17.5,2 12,2M10.5,10.5C10.5,12.43 8.93,14 7,14C5.07,14 3.5,12.43 3.5,10.5C3.5,8.57 5.07,7 7,7C8.93,7 10.5,8.57 10.5,10.5Z"/>
                            </Viewbox>
                        </Border>
                        
                        <!-- App Title -->
                        <TextBlock Text="PaL.Xtreme" FontSize="30" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center" FontFamily="Segoe UI">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.12"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="HeaderSubtitle" Text="Connectez-vous pour continuer" FontSize="13" 
                                   Foreground="#B0FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" 
                                   FontFamily="Segoe UI" FontWeight="Normal"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content Area with Overlap Effect -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="0,0,24,24" Margin="0,-25,0,0">
                <!-- Top rounded corners overlap -->
                <Border.Clip>
                    <RectangleGeometry RadiusX="24" RadiusY="24" Rect="0,0,460,500"/>
                </Border.Clip>
                
                <Grid>
                    <!-- Rounded top overlay -->
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="28,28,0,0" 
                            VerticalAlignment="Top" Height="50" Margin="0,-25,0,0"/>
                    
                    <local:LoginView x:Name="LoginView" Visibility="Visible" HorizontalAlignment="Stretch"/>
                    <local:RegisterView x:Name="RegisterView" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
