<Window x:Class="PaLX.Client.GlobalAnnouncementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annonce"
        Width="450"
        Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <!-- Animation d'entrée -->
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(Window.RenderTransform).(TranslateTransform.Y)"
                           From="-20" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <!-- Animation de sortie -->
        <Storyboard x:Key="SlideOut" Completed="SlideOut_Completed">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Window.RenderTransform).(TranslateTransform.Y)"
                           To="-20" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    
    <Window.RenderTransform>
        <TranslateTransform/>
    </Window.RenderTransform>
    
    <Border x:Name="MainBorder" 
            CornerRadius="12" 
            Margin="20"
            Background="#1E1E2E"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header avec icône et titre -->
            <Border Grid.Row="0" 
                    x:Name="HeaderBorder"
                    CornerRadius="12,12,0,0" 
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icône -->
                    <Border Grid.Column="0" 
                            Width="40" Height="40" 
                            CornerRadius="20"
                            x:Name="IconBorder"
                            Background="#FFFFFF20"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="IconText"
                                 Text="ℹ️"
                                 FontSize="20"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Titre -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                 Text="Annonce"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="White"/>
                        <TextBlock x:Name="SenderText"
                                 Text="De: Admin"
                                 FontSize="11"
                                 Foreground="#888888"
                                 Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Bouton fermer -->
                    <Button Grid.Column="2"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕" 
                                 FontSize="14" 
                                 Foreground="#888888"
                                 HorizontalAlignment="Center"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="14">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Message -->
            <Border Grid.Row="1" Padding="20,12,20,16">
                <TextBlock x:Name="MessageText"
                         Text="Message de l'annonce..."
                         FontSize="14"
                         Foreground="#CCCCCC"
                         TextWrapping="Wrap"
                         LineHeight="22"/>
            </Border>
            
            <!-- Footer avec timestamp -->
            <Border Grid.Row="2" 
                    Background="#00000020" 
                    CornerRadius="0,0,12,12"
                    Padding="16,10">
                <Grid>
                    <TextBlock x:Name="TimestampText"
                             Text="Il y a quelques secondes"
                             FontSize="11"
                             Foreground="#666666"
                             HorizontalAlignment="Left"/>
                    
                    <Button Content="Fermer"
                            HorizontalAlignment="Right"
                            Padding="16,6"
                            FontSize="12"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FFFFFF15"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF25"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
