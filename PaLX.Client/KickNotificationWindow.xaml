<Window x:Class="PaLX.Client.KickNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expulsion" Height="500" Width="480"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">
    
    <!-- Main Container -->
    <Border x:Name="MainBorder" CornerRadius="24" Margin="15">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#F8F9FA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25" Color="#1A1A2E"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header avec dégradé orange -->
            <Border Grid.Row="0" CornerRadius="24,24,0,0" Padding="0,28,0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF6B35" Offset="0"/>
                        <GradientStop Color="#F7931E" Offset="0.5"/>
                        <GradientStop Color="#FF6B35" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icône -->
                    <Grid Width="70" Height="70" Margin="0,0,0,16">
                        <Ellipse Width="56" Height="56" Fill="White" Opacity="0.2"/>
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M10,2 L10,4 L5,4 L5,20 L10,20 L10,22 L3,22 L3,2 L10,2 Z"/>
                                <Path Fill="White" Data="M21,12 L15,6 L15,10 L9,10 L9,14 L15,14 L15,18 L21,12 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    
                    <!-- Titre -->
                    <TextBlock Text="Vous avez été expulsé" FontSize="22" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" 
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Contenu -->
            <StackPanel Grid.Row="1" Margin="32,24,32,16" VerticalAlignment="Top">
                <!-- Nom du salon -->
                <Border Background="#FFF4E6" CornerRadius="12" Padding="16,12" Margin="0,0,0,20"
                        HorizontalAlignment="Center" MinWidth="280">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚪" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="RoomNameText" Text="Salon" FontSize="15" FontWeight="Medium" 
                                   Foreground="#E65100" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
                    </StackPanel>
                </Border>
                
                <!-- Raison -->
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Raison" FontSize="12" Foreground="#9CA3AF" FontWeight="Medium"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Border Background="#F3F4F6" CornerRadius="12" Padding="20,14" MinWidth="320" MaxWidth="400">
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ReasonText" Text="Aucune raison spécifiée" 
                                       FontSize="14" Foreground="#4B5563" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" LineHeight="22"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Bouton -->
            <Border Grid.Row="2" Padding="32,8,32,28">
                <Button x:Name="CloseButton" Content="J'ai compris" Width="160" Height="48" 
                        Click="CloseButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" CornerRadius="24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF6B35" Offset="0"/>
                                        <GradientStop Color="#F7931E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF6B35" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" 
                                           FontWeight="SemiBold" FontSize="15" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FF6B35" BlurRadius="20" ShadowDepth="2" Opacity="0.45"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
