<UserControl x:Class="PaLX.Client.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="460">
    
    <UserControl.Resources>
        <!-- Elegant Input Field Container -->
        <Style x:Key="ElegantInputStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Clean TextBox Style -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <!-- Clean PasswordBox Style -->
        <Style x:Key="CleanPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <!-- Icon Circle Style -->
        <Style x:Key="IconCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="9,0,12,0"/>
        </Style>
        
        <!-- Elegant Primary Button -->
        <Style x:Key="ElegantPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="14" Background="#E03E2F">
                            <Border.Effect>
                                <DropShadowEffect Color="#E03E2F" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C93528"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C93528" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A12B22"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D1D5DB"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        
        <!-- Placeholder Style -->
        <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    
    <!-- Smooth Fade-in Animation -->
    <UserControl.RenderTransform>
        <TranslateTransform Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    
    <Grid Background="{StaticResource CardBackgroundBrush}">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,25" Width="340">
            
            <!-- Username Field -->
            <TextBlock Text="Nom d'utilisateur" Style="{StaticResource FieldLabelStyle}"/>
            <Border Style="{StaticResource ElegantInputStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Style="{StaticResource IconCircleStyle}">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   Foreground="#E03E2F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBox x:Name="UsernameBox" Grid.Column="1" Style="{StaticResource CleanTextBoxStyle}" 
                             Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" Text="Choisissez un nom d'utilisateur" 
                               FontSize="14" FontFamily="Segoe UI" Foreground="#9CA3AF" 
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Password Field -->
            <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabelStyle}"/>
            <Border Style="{StaticResource ElegantInputStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Style="{StaticResource IconCircleStyle}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   Foreground="#E03E2F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <PasswordBox x:Name="PasswordBox" Grid.Column="1" Style="{StaticResource CleanPasswordBoxStyle}" 
                                 Margin="0,0,0,0" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordTxtBox" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource CleanTextBoxStyle}"/>
                    <TextBlock x:Name="PasswordPlaceholder" Grid.Column="1" Text="Créez un mot de passe" 
                               Style="{StaticResource PlaceholderStyle}"/>
                    
                    <!-- Show/Hide Password Toggle -->
                    <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="2" Width="38" Height="38" 
                                  Background="Transparent" BorderThickness="0" Click="ShowPasswordToggle_Click" Cursor="Hand" Margin="0,0,6,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="10">
                                    <TextBlock x:Name="icon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                               Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="icon" Property="Text" Value="&#xED1A;"/>
                                        <Setter TargetName="icon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#08000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Confirm Password Field -->
            <TextBlock Text="Confirmer le mot de passe" Style="{StaticResource FieldLabelStyle}"/>
            <Border Style="{StaticResource ElegantInputStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Style="{StaticResource IconCircleStyle}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   Foreground="#E03E2F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1" Style="{StaticResource CleanPasswordBoxStyle}" 
                                 Margin="0,0,14,0" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="ConfirmPasswordPlaceholder" Grid.Column="1" Text="Confirmez votre mot de passe" 
                               Style="{StaticResource PlaceholderStyle}"/>
                </Grid>
            </Border>

            <!-- Register Button -->
            <Button x:Name="RegisterButton" Style="{StaticResource ElegantPrimaryButtonStyle}" 
                    Content="Créer mon compte" Click="RegisterButton_Click"/>

            <!-- Divider -->
            <Grid Margin="0,28,0,24">
                <Rectangle Height="1" Fill="#E5E7EB"/>
                <Border Background="{StaticResource CardBackgroundBrush}" HorizontalAlignment="Center" Padding="16,0">
                    <TextBlock Text="ou" FontSize="12" Foreground="#9CA3AF" FontFamily="Segoe UI"/>
                </Border>
            </Grid>

            <!-- Login Link -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Déjà un compte ? " FontSize="13" FontFamily="Segoe UI" 
                           Foreground="#6B7280" VerticalAlignment="Center"/>
                <Button Style="{StaticResource LinkButtonStyle}" Content="Se connecter" Click="SwitchToLogin_Click" 
                        FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>