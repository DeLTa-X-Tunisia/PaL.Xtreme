<Window x:Class="PaLX.Client.RoomVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vidéos en direct" 
        Height="400" Width="500"
        MinHeight="250" MinWidth="300"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">
    
    <Window.Resources>
        <!-- Bouton de contrôle vidéo -->
        <Style x:Key="VideoControlButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#40FFFFFF" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Bouton de contrôle actif (rouge) -->
        <Style x:Key="VideoControlButtonActive" TargetType="Button" BasedOn="{StaticResource VideoControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#E03E2F" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Bouton header -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style bouton close rouge -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Container principal avec ombre -->
    <Border Background="#1E1E2E" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Video Grid + Controls superposés -->
            </Grid.RowDefinitions>
            
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- HEADER - Déplaçable                                              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E03E2F" Offset="0"/>
                        <GradientStop Color="#8B2920" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Titre et compteur -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📹" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Vidéos en direct" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#40FFFFFF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock x:Name="CameraCountText" Text="0" FontSize="11" 
                                       Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Boutons fenêtre -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource HeaderButton}" Click="Pin_Click" 
                                ToolTip="Épingler/Désépingler">
                            <TextBlock x:Name="PinIcon" Text="📌" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource HeaderButton}" Click="Minimize_Click" ToolTip="Réduire">
                            <TextBlock Text="─" FontSize="14" Foreground="White" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Fermer">
                            <TextBlock Text="✕" FontSize="12" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- VIDEO GRID - Grille adaptive avec contrôles superposés           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="#12121A" CornerRadius="0,0,16,16">
                <Grid x:Name="VideoGridContainer">
                    <!-- État vide -->
                    <Border x:Name="EmptyState" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="Aucune caméra active" FontSize="14" Foreground="#666" 
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="Activez votre caméra pour commencer" FontSize="12" Foreground="#444" 
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <Button x:Name="StartCameraBtn" Content="🎥  Activer ma caméra" 
                                    Margin="0,20,0,0" Padding="20,10" FontSize="13"
                                    Background="#E03E2F" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="ToggleCamera_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF5A4A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Grille vidéo dynamique -->
                    <UniformGrid x:Name="VideoGrid" Visibility="Collapsed">
                        <!-- Les cellules vidéo seront ajoutées dynamiquement -->
                    </UniformGrid>
                    
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- CONTROLS - Barre de contrôle transparente SUPERPOSÉE            -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <Border VerticalAlignment="Bottom" Background="#60000000" CornerRadius="0,0,16,16" Height="70">
                        <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Info gauche -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border x:Name="ConnectionStatus" Background="#4CAF50" CornerRadius="4" 
                                Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="Connecté" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Contrôles centraux -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Micro -->
                        <Button x:Name="MicButton" Style="{StaticResource VideoControlButton}" 
                                Click="ToggleMic_Click" ToolTip="Microphone">
                            <TextBlock x:Name="MicIcon" Text="🎤" FontSize="18"/>
                        </Button>
                        
                        <!-- Caméra -->
                        <Button x:Name="CameraButton" Style="{StaticResource VideoControlButton}" 
                                Click="ToggleCamera_Click" ToolTip="Caméra">
                            <TextBlock x:Name="CameraIcon" Text="📷" FontSize="18"/>
                        </Button>
                        
                        <!-- Changer de caméra -->
                        <Button x:Name="SwitchCameraButton" Style="{StaticResource VideoControlButton}" 
                                Click="SwitchCamera_Click" ToolTip="Changer de caméra">
                            <TextBlock Text="🔄" FontSize="18"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="CameraMenu" Placement="Top">
                                    <!-- Les caméras seront ajoutées dynamiquement -->
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        
                        <!-- Paramètres -->
                        <Button Style="{StaticResource VideoControlButton}" 
                                Click="Settings_Click" ToolTip="Paramètres">
                            <TextBlock Text="⚙️" FontSize="18"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- Info droite - Qualité -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" 
                                HorizontalAlignment="Right" Margin="0,0,16,0">
                        <TextBlock x:Name="QualityText" Text="HD" FontSize="10" Foreground="#888" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BitrateText" Text="0 kbps" FontSize="10" Foreground="#666" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Fin des contrôles superposés -->
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
