<Window x:Class="PaLX.Client.AlreadyConnectedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Active" Height="380" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header avec icône -->
            <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="20,20,0,0" Padding="30,25">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icône animée -->
                    <Border Width="70" Height="70" CornerRadius="35" Background="#FF9800" Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF9800" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Session déjà active" FontSize="22" FontWeight="Bold" 
                               Foreground="#E65100" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Contenu -->
            <StackPanel Grid.Row="1" Margin="30,25">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14" 
                           Foreground="#555" LineHeight="22">
                    <Run Text="Votre compte"/>
                    <Run x:Name="UsernameRun" Text="utilisateur" FontWeight="Bold" Foreground="#E03E2F"/>
                    <Run Text="est actuellement connecté sur un autre appareil."/>
                </TextBlock>
                
                <!-- Info device -->
                <Border Background="#F5F5F5" CornerRadius="12" Padding="15" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="💻" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DeviceInfoText" Text="Appareil inconnu" 
                                       FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="🕐" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionTimeText" Text="Connecté depuis..." 
                                       FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <TextBlock Text="Souhaitez-vous déconnecter l'autre session et continuer ici ?" 
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13" 
                           Foreground="#777" Margin="0,20,0,0"/>
            </StackPanel>
            
            <!-- Boutons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,0,30,25">
                <Button x:Name="CancelButton" Content="Annuler" 
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#9E9E9E" Width="140" Margin="0,0,15,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="ForceConnectButton" Content="Se connecter ici" 
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#E03E2F" Width="180"
                        Click="ForceConnectButton_Click"/>
            </StackPanel>
            
            <!-- Close button -->
            <Button x:Name="CloseButton" Click="CancelButton_Click"
                    Width="30" Height="30" Background="Transparent"
                    VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,15,15,0"
                    Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#10000000" CornerRadius="15">
                            <TextBlock Text="✕" FontSize="14" Foreground="#999"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
