<Window x:Class="PaLX.Client.RoomInvitationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PaLX.Client.Converters"
        Title="Invitation"
        Width="380"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- URL to Image Converter -->
        <converters:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter"/>
        
        <!-- Animation for slide in -->
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="(Window.Opacity)"
                           From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetName="MainBorder"
                               Storyboard.TargetProperty="Margin"
                               From="0,-30,0,30" To="0,0,0,0" Duration="0:0:0.35">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
        
        <!-- Animation for slide out -->
        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetProperty="(Window.Opacity)"
                           From="1" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetName="MainBorder"
                               Storyboard.TargetProperty="Margin"
                               From="0,0,0,0" To="0,30,0,-30" Duration="0:0:0.25">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
        
        <!-- Button Style -->
        <Style x:Key="InviteButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder"
            CornerRadius="16"
            Margin="0"
            Background="#FF1E1E1E"
            BorderThickness="1"
            BorderBrush="#FF3D3D3D">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="35" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with gradient -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#66BB6A" Offset="0"/>
                        <GradientStop Color="#43A047" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Bell Icon -->
                    <Border Grid.Column="0" Background="#20FFFFFF" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                        <Path Fill="White" Stretch="Uniform" Width="22" Height="22"
                              Data="M12,22 C13.1,22 14,21.1 14,20 L10,20 C10,21.1 10.89,22 12,22 Z M18,16 L18,11 C18,7.93 16.36,5.36 13.5,4.68 L13.5,4 C13.5,3.17 12.83,2.5 12,2.5 C11.17,2.5 10.5,3.17 10.5,4 L10.5,4.68 C7.63,5.36 6,7.92 6,11 L6,16 L4,18 L4,19 L20,19 L20,18 L18,16 Z"/>
                    </Border>
                    
                    <!-- Title -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Invitation au salon" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Quelqu'un vous invite!" FontSize="12" Foreground="#DDFFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2" Click="Close_Click" 
                            Background="Transparent" Width="32" Height="32" Cursor="Hand" BorderThickness="0"
                            VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="✕" Foreground="#AAFFFFFF" FontSize="14" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Inviter Info -->
            <Border Grid.Row="1" Padding="20,16" Background="#FF252525">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Avatar -->
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" 
                            Background="#3D3D3D" Margin="0,0,14,0"
                            BorderThickness="3" BorderBrush="#66BB6A">
                        <Grid>
                            <Image x:Name="InviterAvatar" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                                </Image.Clip>
                            </Image>
                            <TextBlock x:Name="InviterAvatarFallback" Text="👤" FontSize="24" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    
                    <!-- Name & Message -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="InviterNameText" Text="Nom de l'inviteur" 
                                   FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="vous invite à rejoindre un salon" 
                                   FontSize="13" Foreground="#AAAAAA" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Room Info -->
            <Border Grid.Row="2" Background="#FF1E1E1E" Padding="20,14">
                <Border Background="#FF2D2D2D" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Room Icon -->
                        <Border Grid.Column="0" Background="#66BB6A" CornerRadius="10" Width="48" Height="48" Margin="0,0,14,0">
                            <TextBlock x:Name="RoomIconText" Text="💬" FontSize="24" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Room Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="RoomNameText" Text="Nom du salon" 
                                       FontSize="15" FontWeight="SemiBold" Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#20FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock x:Name="RoomCategoryText" Text="Catégorie" 
                                               FontSize="11" Foreground="#AAAAAA"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            
            <!-- Action Buttons -->
            <Border Grid.Row="3" CornerRadius="0,0,16,16" Padding="20,14,20,20" Background="#FF1E1E1E">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Refuse Button -->
                    <Button Grid.Column="0" Content="Refuser" 
                            Background="#3D3D3D" Foreground="White"
                            Style="{StaticResource InviteButtonStyle}"
                            Click="Refuse_Click"/>
                    
                    <!-- Accept Button -->
                    <Button Grid.Column="2" Content="Rejoindre" 
                            Background="#66BB6A" Foreground="White"
                            Style="{StaticResource InviteButtonStyle}"
                            Click="Accept_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
