<Window x:Class="PaLX.Client.SessionKickedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session terminée" Height="280" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">
    
    <Border Background="#FF2D2D30" CornerRadius="15" BorderBrush="#FF3E3E42" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#80000000"/>
        </Border.Effect>
        
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Icon and Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Border Width="50" Height="50" CornerRadius="25" Background="#30FF6B6B" Margin="0,0,12,0">
                    <TextBlock Text="⚠" FontSize="26" Foreground="#FFFF6B6B" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Session terminée" FontSize="22" FontWeight="SemiBold" 
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Message -->
            <Border Grid.Row="1" Background="#20FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <TextBlock x:Name="MessageText" 
                           Text="Vous avez été déconnecté car une nouvelle session a été ouverte depuis un autre appareil."
                           TextWrapping="Wrap" 
                           Foreground="#FFCCCCCC" 
                           FontSize="13"
                           TextAlignment="Center"
                           LineHeight="20"/>
            </Border>
            
            <!-- Info Icon -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ℹ" FontSize="16" Foreground="#FF6B9AFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Pour des raisons de sécurité, une seule session est autorisée à la fois."
                           Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" MaxWidth="280"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- OK Button -->
            <Button Grid.Row="3" 
                    Content="J'ai compris" 
                    Click="OkButton_Click"
                    Width="140" Height="38"
                    HorizontalAlignment="Center"
                    Background="#FF0078D4" 
                    Foreground="White" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E88E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
