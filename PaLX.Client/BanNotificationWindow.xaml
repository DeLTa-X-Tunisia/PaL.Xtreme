<Window x:Class="PaLX.Client.BanNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bannissement" Height="440" Width="480"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">
    
    <Window.Resources>
        <!-- Animation de pulsation pour l'icône -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="IconGlow" 
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.8" Duration="0:0:1.5"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <!-- Animation d'entrée de la fenêtre -->
        <Storyboard x:Key="WindowEnterAnimation">
            <DoubleAnimation Storyboard.TargetName="MainBorder" 
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainBorder" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.8" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainBorder" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.8" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowEnterAnimation}"/>
            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <!-- Main Container -->
    <Border x:Name="MainBorder" CornerRadius="24" Margin="15" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#F8F9FA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25" Color="#1A1A2E"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header avec dégradé rouge -->
            <Border Grid.Row="0" CornerRadius="24,24,0,0" Padding="0,28,0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DC2626" Offset="0"/>
                        <GradientStop Color="#EF4444" Offset="0.5"/>
                        <GradientStop Color="#DC2626" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icône animée avec glow -->
                    <Grid Width="70" Height="70" Margin="0,0,0,16">
                        <!-- Glow effect -->
                        <Ellipse x:Name="IconGlow" Width="70" Height="70" Opacity="0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Cercle de fond -->
                        <Ellipse Width="56" Height="56" Fill="White" Opacity="0.2"/>
                        <!-- Icône ban -->
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <!-- Ban/Block icon -->
                                <Path Fill="White" Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M4,12 C4,7.58 7.58,4 12,4 C13.85,4 15.55,4.63 16.9,5.69 L5.69,16.9 C4.63,15.55 4,13.85 4,12 Z M12,20 C10.15,20 8.45,19.37 7.1,18.31 L18.31,7.1 C19.37,8.45 20,10.15 20,12 C20,16.42 16.42,20 12,20 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    
                    <!-- Titre -->
                    <TextBlock Text="Vous avez été banni" FontSize="22" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" 
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Contenu -->
            <StackPanel Grid.Row="1" Margin="32,20,32,12" VerticalAlignment="Top">
                <!-- Nom du salon -->
                <Border Background="#FEE2E2" CornerRadius="12" Padding="16,12" Margin="0,0,0,18"
                        HorizontalAlignment="Center" MinWidth="280">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚫" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="RoomNameText" Text="Salon de Test" FontSize="15" FontWeight="Medium" 
                                   Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
                    </StackPanel>
                </Border>
                
                <!-- Raison -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="Raison" FontSize="12" Foreground="#9CA3AF" FontWeight="Medium"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Border Background="#F3F4F6" CornerRadius="12" Padding="20,14" MinWidth="320" MaxWidth="400">
                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ReasonText" Text="Aucune raison spécifiée" 
                                       FontSize="14" Foreground="#4B5563" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" LineHeight="22"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                
                <!-- Durée -->
                <Border x:Name="DurationBorder" Background="#FEF3C7" CornerRadius="10" Padding="16,10" 
                        HorizontalAlignment="Center" MinWidth="200">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DurationText" Text="Durée : 24 heures" FontSize="13" 
                                   FontWeight="Medium" Foreground="#92400E" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bouton -->
            <Border Grid.Row="2" Padding="32,8,32,28">
                <Button x:Name="CloseButton" Content="J'ai compris" Width="160" Height="48" 
                        Click="CloseButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" CornerRadius="24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#DC2626" Offset="0"/>
                                        <GradientStop Color="#EF4444" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#DC2626" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" 
                                           FontWeight="SemiBold" FontSize="15" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#DC2626" BlurRadius="20" ShadowDepth="2" Opacity="0.45"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
