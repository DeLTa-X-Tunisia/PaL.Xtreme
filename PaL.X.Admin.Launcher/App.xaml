<Application x:Class="PaL.X.Admin.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Colors -->
            <Color x:Key="PrimaryDark">#1a1a2e</Color>
            <Color x:Key="SecondaryDark">#16213e</Color>
            <Color x:Key="AccentPurple">#7c3aed</Color>
            <Color x:Key="AccentCyan">#06b6d4</Color>
            <Color x:Key="SuccessGreen">#10b981</Color>
            <Color x:Key="WarningOrange">#f59e0b</Color>
            <Color x:Key="ErrorRed">#ef4444</Color>

            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
            <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDark}"/>
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
            <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
            <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>
            <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource WarningOrange}"/>
            <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}"/>

            <!-- Gradient Brushes -->
            <LinearGradientBrush x:Key="PurpleCyanGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource AccentPurple}" Offset="0"/>
                <GradientStop Color="{StaticResource AccentCyan}" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DarkGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#0f0f1a" Offset="1"/>
            </LinearGradientBrush>

            <!-- Card Style -->
            <Style x:Key="ModernCard" TargetType="Border">
                <Setter Property="Background" Value="#252540"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Button Style -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource PurpleCyanGradient}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="24,12"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="24,12"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
