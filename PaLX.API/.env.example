# PaLX.API Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Database Password (REQUIRED)
PALX_DB_PASSWORD=your_password_here

# JWT Secret Key (REQUIRED - minimum 32 characters)
PALX_JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars

# Optional: Database connection details (defaults shown)
# PALX_DB_HOST=localhost
# PALX_DB_PORT=5432
# PALX_DB_NAME=PaL.X
# PALX_DB_USER=postgres
