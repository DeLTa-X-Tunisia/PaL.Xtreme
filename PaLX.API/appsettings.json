{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Username=postgres;Password=${DB_PASSWORD};Database=PaL.X"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "PaLX.API",
    "Audience": "PaLX.Client"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "https://admin.palxtreme.com",
      "https://panel.palxtreme.com"
    ]
  },
  "Database": {
    "MinPoolSize": 10,
    "MaxPoolSize": 100,
    "ConnectionIdleLifetimeSeconds": 300,
    "ConnectionPruningIntervalSeconds": 60,
    "CommandTimeoutSeconds": 30,
    "EnableMultiplexing": false,
    "EnableQueryLogging": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Password": null,
    "InstanceName": "PaLX:",
    "Database": 0,
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000,
    "UseSsl": false,
    "AbortOnConnectFail": false,
    "EnableDistributedCache": false,
    "EnableSignalRBackplane": false
  },
  "SignalR": {
    "MaximumReceiveMessageSizeKB": 64,
    "StreamBufferCapacity": 20,
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutSeconds": 60,
    "HandshakeTimeoutSeconds": 15,
    "EnableDetailedErrors": false,
    "MaxConnectionsPerUser": 5
  },
  "Cache": {
    "DefaultL1ExpirationSeconds": 30,
    "DefaultL2ExpirationSeconds": 300
  },
  "MySqlSync": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 3306,
    "Database": "pal_xtreme",
    "User": "root",
    "Password": ""
  }
}
